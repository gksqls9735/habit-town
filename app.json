{
  "expo": {
    "name": "GROMI",
    "slug": "habit-town",
    "version": "1.0.0",
    "icon": "./assets/png/ui/gromi-app-icon-hamster-simple.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/png/ui/gromi-app-icon-hamster-simple.png",
      "splash": {
        "backgroundColor": "#FFF9EE",
        "resizeMode": "contain",
        "image": "./assets/common/splash/growmi-splash.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EE",
          "image": "./assets/common/splash/growmi-splash.png",
          "imageWidth": 340,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
